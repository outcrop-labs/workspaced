[Desktop Entry]
Type=Application
Name={{name}}
GenericName=Google Workspace
Comment=Several Google Workspace accounts, signed in at once
Exec={{exec}} %u
Icon={{icon}}
Terminal=false
Categories=Network;Email;Office;
Keywords=gmail;google;calendar;drive;docs;sheets;workspace;mail;
MimeType=x-scheme-handler/mailto;
StartupWMClass=workspaced
StartupNotify=true
